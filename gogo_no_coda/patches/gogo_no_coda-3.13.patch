diff --git a/engine/generic/gthread.c b/engine/generic/gthread.c
new file mode 100644
index 0000000..3715826
--- /dev/null
+++ b/engine/generic/gthread.c
@@ -0,0 +1,50 @@
+/*
+ *   POSIX threads + CPU detection for builds that do not use linux/thread.c
+ *   (Haiku, and other systems without /proc/cpuinfo).
+ *
+ *   part of this code is origined from
+ *   GOGO-no-coda
+ *
+ *   Copyright(C) 2001,2002,2003 gogo-developer
+ */
+
+#ifdef	USE_PTHREAD
+/* gogo_initialize_thread_unit(), gogo_create_thread() */
+#include "../../pthread/thread.c"
+
+#include <unistd.h>
+#if defined(__HAIKU__) || defined(__BEOS__)
+#	include <OS.h>	/* get_system_info() */
+#endif
+
+/* number of CPUs, or 0 if it can not be found out */
+static int
+detectCPUs(void)
+{
+#if defined(__HAIKU__) || defined(__BEOS__)
+	system_info info;
+
+	if (get_system_info(&info) == B_OK) return (int)info.cpu_count;
+#elif defined(_SC_NPROCESSORS_ONLN)
+	long n = sysconf(_SC_NPROCESSORS_ONLN);
+
+	if (n > 0) return (int)n;
+#endif
+	return 0;
+} /* detectCPUs */
+
+int
+gogo_get_cpu_count(int *pCPUs, int *pTHREADs)
+{
+	if(*pCPUs == 0){
+		/* auto */
+		int nCPU = detectCPUs();
+
+		*pCPUs = nCPU <= 1 ? 1 : nCPU;
+	}
+	/* manual: use the value given with -cpu */
+	*pTHREADs = *pCPUs;
+
+	return 0;
+} /* gogo_get_cpu_count */
+#endif

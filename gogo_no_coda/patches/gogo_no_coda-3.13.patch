diff --git a/linux/Makefile.generic b/linux/Makefile.generic
new file mode 100644
index 0000000..ccb1107
--- /dev/null
+++ b/linux/Makefile.generic
@@ -0,0 +1,56 @@
+#######################################################
+#
+#   Makefile for GOGO-no-coda, plain C build (no NASM/x86 asm)
+#   for 64bit targets (x86_64 ...)
+#
+#######################################################
+
+TARGET = gogo
+prefix =
+BINDIR = $(prefix)/bin
+
+CC   = gcc
+LD   = gcc
+CINC = -I../engine -I../file_io/libsnd
+LIBS = -lm
+VPATH = ../engine:../engine/generic:../file_io
+
+CFLAGS = -Wall -DNDEBUG -DHAVE_CONFIG_H -DLAMEPARSE -DLAMESNDFILE
+CFLAGS += -O2 -ffast-math -funroll-loops
+# the code type-puns float<->int all over (IEEE754 tricks); do not let gcc optimise on strict aliasing
+CFLAGS += -fno-strict-aliasing
+
+COBJS =	bitstream.o get_audio.o \
+	newmdct.o quantize_pvt.o \
+	tables.o util.o \
+	gogo.o \
+	psymodel.o reservoir.o \
+	takehiro.o \
+	fft.o lame.o \
+	quantize.o \
+	tool.o vbrtag.o \
+	main.o gogo_io.o setup.o \
+	cpu.o
+
+# threads (POSIX threads are part of libroot on Haiku)
+CFLAGS += -DUSE_PTHREAD
+COBJS += gthread.o
+
+all: $(TARGET)
+
+install : $(TARGET)
+	mkdir -p $(DESTDIR)$(BINDIR)
+	install -m 0755 $(TARGET) $(DESTDIR)$(BINDIR)
+	strip $(DESTDIR)$(BINDIR)/$(TARGET)
+
+$(TARGET): $(COBJS)
+	$(LD) $(COBJS) $(LDFLAGS) -o $(TARGET) $(LIBS)
+
+.c.o:
+	$(CC) -c $(CFLAGS) $(CINC) $< -o $@
+
+main.o: ../main.c
+	$(CC) -c $(CFLAGS) $(CINC) $< -o $@
+
+clean:
+	rm -f *.o $(TARGET) *~
